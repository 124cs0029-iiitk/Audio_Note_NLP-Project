{
  "manifest_version": 3,
  "name": "Meeting Agent speaker bridge",
  "version": "0.1",
  "description": "Tells the Meeting Agent page who is speaking in Google Meet.",
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["meet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
      "js": ["agent.js"],
      "run_at": "document_idle"
    }
  ]
}